# 示例环境变量文件。setup.ps1 会按你的选择自动生成 deploy/.env。
# 这个文件只是给人看的格式参考，请勿把真实 Key 填进来再提交。

# 本地 Swarm API 的鉴权 Key（setup.ps1 会随机生成一个 64 位十六进制串）
API_KEY=

# AI 员工用哪个 harness：opencode | openrouter | anthropic | openai
HARNESS_PROVIDER=opencode

# 留空 = 让 harness 自己选默认模型
MODEL_OVERRIDE=

# 供容器内部互相调用
MCP_BASE_URL=http://api:3013
APP_URL=http://localhost:3013

# agent-swarm 源码目录（docker build 的 context）
SWARM_SRC=

# 只有当 HARNESS_PROVIDER 不是 opencode 时才需要，二选一或都填：
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
